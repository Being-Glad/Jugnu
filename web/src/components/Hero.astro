---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Content Column -->
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot">●</span>
          <span>THE THANOS EVOLUTION</span>
        </div>

        <h1 class="hero-title">
          Snap away the old. <br/>
          <span class="gradient-text">Welcome Jugnu.</span>
        </h1>

        <p class="hero-subtitle">
          Watch the legacy Metrolist interface disintegrate away. Jugnu delivers low-latency playback, Apple-style live synced lyrics, AI translation, and built-in AI music recommendation.
        </p>

        <div class="hero-actions">
          <a href="https://github.com/Being-Glad/Jugnu/releases/latest/download/Jugnu.apk" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Download Jugnu APK</span>
          </a>

          <button class="btn btn-secondary" id="trigger-snap-btn">
            <span>🤌 Snap Again</span>
          </button>
        </div>

        <div class="hero-meta">
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Free & Open Source</span>
          </div>
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>No Ads</span>
          </div>
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Low Latency</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Thanos Snap Transformation -->
      <div class="hero-showcase">
        <div class="snap-wrapper" id="snap-wrapper" title="Click to trigger Thanos Snap">
          
          <!-- Layer B: Redesigned Jugnu Home Screen (Underneath) -->
          <div class="jugnu-screen-layer" id="jugnu-layer">
            <div class="screen-badge tag-jugnu">✨ Jugnu (Redesigned)</div>
            <img src="/screenshots/home.jpg" alt="Jugnu Redesigned Home Screen" />
          </div>

          <!-- Layer A: Metrolist Original Home Screen (Top Overlay) -->
          <div class="metrolist-screen-layer" id="metrolist-layer">
            <div class="screen-badge tag-metrolist">● Metrolist (Original)</div>
            <img id="metrolist-img" src="/screenshots/metrolist_old.jpg" alt="Original Metrolist Home Screen" />
            <canvas id="thanos-canvas"></canvas>
          </div>

          <div class="snap-hint-bar">
            <span id="snap-status-text">🤌 Tap image to snap away Metrolist</span>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const wrapper = document.getElementById('snap-wrapper');
  const metrolistLayer = document.getElementById('metrolist-layer');
  const metrolistImg = document.getElementById('metrolist-img') as HTMLImageElement;
  const canvas = document.getElementById('thanos-canvas') as HTMLCanvasElement;
  const triggerBtn = document.getElementById('trigger-snap-btn');
  const statusText = document.getElementById('snap-status-text');

  let isSnapped = false;
  let isAnimating = false;

  function doThanosSnap() {
    if (isAnimating) return;
    isAnimating = true;

    if (!canvas || !metrolistImg || !metrolistLayer) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const width = metrolistLayer.clientWidth;
    const height = metrolistLayer.clientHeight;
    canvas.width = width;
    canvas.height = height;

    // Draw metrolist image onto canvas
    ctx.drawImage(metrolistImg, 0, 0, width, height);
    const imgData = ctx.getImageData(0, 0, width, height);
    const data = imgData.data;

    // Hide original metrolist image
    metrolistImg.style.opacity = '0';
    if (statusText) statusText.innerHTML = '💥 Disintegrating Metrolist...';

    // Generate dust particles from pixels
    const particles: Array<{
      x: number;
      y: number;
      color: string;
      vx: number;
      vy: number;
      size: number;
      alpha: number;
      delay: number;
    }> = [];

    const step = 6; // Sampling frequency
    for (let y = 0; y < height; y += step) {
      for (let x = 0; x < width; x += step) {
        const index = (y * width + x) * 4;
        const a = data[index + 3];
        if (a > 30) {
          const r = data[index];
          const g = data[index + 1];
          const b = data[index + 2];

          // Particle delay based on horizontal position (snaps left to right)
          const delay = (x / width) * 400 + Math.random() * 200;

          particles.push({
            x: x,
            y: y,
            color: `rgba(${r}, ${g}, ${b}, 1)`,
            vx: 1.5 + Math.random() * 3, // Fly rightward
            vy: -1.2 - Math.random() * 2.5, // Fly upward
            size: Math.random() * 3 + 1.5,
            alpha: 1,
            delay: delay
          });
        }
      }
    }

    const startTime = performance.now();

    function animateParticles(now: number) {
      const elapsed = now - startTime;
      ctx.clearRect(0, 0, width, height);

      let activeCount = 0;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        if (elapsed < p.delay) {
          // Draw pixel before it disintegrates
          ctx.fillStyle = p.color;
          ctx.fillRect(p.x, p.y, p.size, p.size);
          activeCount++;
        } else {
          // Particle has snapped!
          const pElapsed = elapsed - p.delay;
          if (pElapsed < 1200) {
            p.x += p.vx + Math.sin(pElapsed / 50) * 0.5;
            p.y += p.vy;
            p.alpha = Math.max(0, 1 - pElapsed / 1200);

            ctx.fillStyle = p.color;
            ctx.globalAlpha = p.alpha;
            ctx.fillRect(p.x, p.y, p.size, p.size);
            ctx.globalAlpha = 1;
            activeCount++;
          }
        }
      }

      if (activeCount > 0) {
        requestAnimationFrame(animateParticles);
      } else {
        ctx.clearRect(0, 0, width, height);
        metrolistLayer.style.pointerEvents = 'none';
        metrolistLayer.style.opacity = '0';
        isSnapped = true;
        isAnimating = false;
        if (statusText) statusText.innerHTML = '✨ Jugnu Born! (Tap to reset)';
      }
    }

    requestAnimationFrame(animateParticles);
  }

  function resetSnap() {
    if (isAnimating) return;
    if (!metrolistImg || !metrolistLayer || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);

    metrolistLayer.style.pointerEvents = 'auto';
    metrolistLayer.style.opacity = '1';
    metrolistImg.style.opacity = '1';
    isSnapped = false;
    if (statusText) statusText.innerHTML = '🤌 Tap image to snap away Metrolist';
  }

  wrapper?.addEventListener('click', () => {
    if (!isSnapped) {
      doThanosSnap();
    } else {
      resetSnap();
    }
  });

  triggerBtn?.addEventListener('click', () => {
    if (isSnapped) {
      resetSnap();
      setTimeout(doThanosSnap, 400);
    } else {
      doThanosSnap();
    }
  });

  // Auto-trigger Thanos snap 1.8 seconds after load so user sees the magic!
  setTimeout(() => {
    if (!isSnapped && !isAnimating) {
      doThanosSnap();
    }
  }, 1800);
</script>

<style>
.hero {
  position: relative;
  padding: 8.5rem 0 5rem;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
  align-items: center;
}

.hero-content {
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.4rem 1.1rem;
  border-radius: var(--radius-full);
  background: rgba(6, 182, 212, 0.08);
  border: 1px solid var(--border-highlight);
  color: var(--accent-cyan);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  margin-bottom: 1.5rem;
}

.badge-dot {
  font-size: 0.7rem;
  color: var(--accent-teal);
}

.hero-title {
  font-size: 4.2rem;
  letter-spacing: -2px;
  line-height: 1.05;
  margin-bottom: 1.4rem;
  font-weight: 800;
}

.hero-subtitle {
  font-size: 1.15rem;
  color: var(--text-secondary);
  margin-bottom: 2.4rem;
  max-width: 520px;
  font-weight: 400;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 2.2rem;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  color: var(--text-muted);
  font-size: 0.88rem;
}

.hero-meta-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.hero-meta-item svg {
  color: var(--accent-teal);
}

.hero-showcase {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.snap-wrapper {
  position: relative;
  width: 270px;
  height: 570px;
  cursor: pointer;
}

/* Base Screen Container */
.jugnu-screen-layer, .metrolist-screen-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 260px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: #080c14;
  box-shadow: 0 25px 55px -8px rgba(0, 0, 0, 0.9), 0 0 35px rgba(6, 182, 212, 0.3);
  transition: opacity 0.5s ease;
}

.jugnu-screen-layer img, .metrolist-screen-layer img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  transition: opacity 0.3s ease;
}

.metrolist-screen-layer {
  z-index: 10;
}

.jugnu-screen-layer {
  z-index: 5;
}

canvas#thanos-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 12;
}

/* Badges */
.screen-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 20;
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  backdrop-filter: blur(8px);
}

.tag-metrolist {
  background: rgba(15, 23, 42, 0.85);
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.tag-jugnu {
  background: rgba(6, 182, 212, 0.9);
  color: #041019;
  box-shadow: 0 4px 15px rgba(6, 182, 212, 0.4);
}

.snap-hint-bar {
  position: absolute;
  bottom: -45px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 0.82rem;
  color: var(--text-muted);
  font-weight: 600;
  transition: color 0.2s ease;
}

.snap-wrapper:hover .snap-hint-bar {
  color: var(--accent-cyan);
}

@media (max-width: 992px) {
  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: 3.2rem;
  }

  .hero-actions {
    justify-content: center;
  }

  .hero-showcase {
    margin-top: 2rem;
  }
}
</style>
