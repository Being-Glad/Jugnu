---
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Content Column -->
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot">●</span>
          <span>REDESIGNED & ENHANCED</span>
        </div>

        <h1 class="hero-title">
          Metrolist, evolved into <br/>
          <span class="gradient-text">Jugnu.</span>
        </h1>

        <p class="hero-subtitle">
          We took the open-source Metrolist foundation and transformed it into a lightning-fast, visually stunning YouTube Music experience — with low-latency playback, live synced lyrics, AI translation, and built-in AI music recommendation.
        </p>

        <div class="hero-actions">
          <a href="https://github.com/Being-Glad/Jugnu/releases/latest/download/Jugnu.apk" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Download Jugnu APK</span>
          </a>

          <a href="https://github.com/Being-Glad/Jugnu" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>
        </div>

        <div class="hero-meta">
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Free & Open Source</span>
          </div>
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>No Ads</span>
          </div>
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Low Latency</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Before (Metrolist) -> After (Jugnu Redesign) Transition -->
      <div class="hero-showcase">
        <div class="stacked-screens-wrapper" id="morph-container" title="Click to cycle before & after UI">
          <div class="stacked-screens" id="stacked-screens">
            <!-- Screen 1: Original Metrolist (Before) -->
            <div class="screen-card card-old" id="card-old">
              <div class="screen-tag tag-before">Metrolist (Original)</div>
              <img src="/screenshots/metrolist_old.jpg" alt="Original Metrolist Interface" />
            </div>

            <!-- Screen 2: Jugnu Home Redesign (After) -->
            <div class="screen-card card-jugnu-home" id="card-jugnu-home">
              <div class="screen-tag tag-after">Jugnu (Redesigned)</div>
              <img src="/screenshots/home.jpg" alt="Jugnu Redesigned Home Screen" />
            </div>

            <!-- Screen 3: Jugnu Player Redesign -->
            <div class="screen-card card-jugnu-player" id="card-jugnu-player">
              <div class="screen-tag tag-after">Jugnu (Now Playing)</div>
              <img src="/screenshots/player.jpg" alt="Jugnu Player Screen" />
            </div>
          </div>

          <div class="morph-status" id="morph-status">
            <span class="status-indicator" id="status-indicator">● Metrolist Original</span>
            <span class="swap-action-hint">Tap to transform ⚡</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('morph-container');
  const cardOld = document.getElementById('card-old');
  const cardHome = document.getElementById('card-jugnu-home');
  const cardPlayer = document.getElementById('card-jugnu-player');
  const statusIndicator = document.getElementById('status-indicator');

  if (container && cardOld && cardHome && cardPlayer && statusIndicator) {
    let state = 0; // 0: Metrolist Old, 1: Jugnu Home, 2: Jugnu Player

    const updateCards = () => {
      if (state === 0) {
        // Metrolist Old front
        cardOld.className = 'screen-card card-front';
        cardHome.className = 'screen-card card-middle';
        cardPlayer.className = 'screen-card card-back';
        statusIndicator.innerHTML = '● <strong style="color: #94a3b8">Metrolist (Original)</strong>';
      } else if (state === 1) {
        // Jugnu Home front (Metrolist slides away)
        cardOld.className = 'screen-card card-disappear';
        cardHome.className = 'screen-card card-front';
        cardPlayer.className = 'screen-card card-middle';
        statusIndicator.innerHTML = '✨ <strong style="color: var(--accent-cyan)">Jugnu Redesigned Home</strong>';
      } else if (state === 2) {
        // Jugnu Player front
        cardOld.className = 'screen-card card-back';
        cardHome.className = 'screen-card card-middle';
        cardPlayer.className = 'screen-card card-front';
        statusIndicator.innerHTML = '🎵 <strong style="color: var(--accent-teal)">Jugnu Synced Player</strong>';
      }
    };

    updateCards();

    const nextState = () => {
      state = (state + 1) % 3;
      updateCards();
    };

    container.addEventListener('click', nextState);

    // Auto transformation cycle: shows Metrolist old briefly, then morphs into Jugnu!
    let timer = setInterval(nextState, 3800);

    container.addEventListener('mouseenter', () => clearInterval(timer));
    container.addEventListener('mouseleave', () => {
      timer = setInterval(nextState, 3800);
    });
  }
</script>

<style>
.hero {
  position: relative;
  padding: 8.5rem 0 5rem;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
  align-items: center;
}

.hero-content {
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.4rem 1.1rem;
  border-radius: var(--radius-full);
  background: rgba(6, 182, 212, 0.08);
  border: 1px solid var(--border-highlight);
  color: var(--accent-cyan);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  margin-bottom: 1.5rem;
}

.badge-dot {
  font-size: 0.7rem;
  color: var(--accent-teal);
}

.hero-title {
  font-size: 4.2rem;
  letter-spacing: -2px;
  line-height: 1.05;
  margin-bottom: 1.4rem;
  font-weight: 800;
}

.hero-subtitle {
  font-size: 1.15rem;
  color: var(--text-secondary);
  margin-bottom: 2.4rem;
  max-width: 520px;
  font-weight: 400;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 2.2rem;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  color: var(--text-muted);
  font-size: 0.88rem;
}

.hero-meta-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.hero-meta-item svg {
  color: var(--accent-teal);
}

.hero-showcase {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.stacked-screens-wrapper {
  position: relative;
  cursor: pointer;
  padding: 10px;
}

.stacked-screens {
  position: relative;
  width: 270px;
  height: 570px;
}

/* Card Styling */
.screen-card {
  position: absolute;
  top: 0;
  left: 0;
  width: 260px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: #080c14;
  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.85);
  transition: transform 0.7s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.7s ease, filter 0.7s ease;
}

.screen-card img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}

/* Screen Tags */
.screen-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
  padding: 0.3rem 0.75rem;
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  backdrop-filter: blur(8px);
}

.tag-before {
  background: rgba(15, 23, 42, 0.85);
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.tag-after {
  background: rgba(6, 182, 212, 0.9);
  color: #041019;
  box-shadow: 0 4px 15px rgba(6, 182, 212, 0.4);
}

/* Card Stack States */
.card-front {
  z-index: 10;
  transform: rotate(-3deg) scale(1);
  opacity: 1;
  filter: brightness(1);
  box-shadow: 0 25px 55px -8px rgba(0, 0, 0, 0.9), 0 0 35px rgba(6, 182, 212, 0.3);
}

.card-middle {
  z-index: 5;
  transform: rotate(5deg) translateX(30px) scale(0.94);
  opacity: 0.8;
  filter: brightness(0.85);
}

.card-back {
  z-index: 2;
  transform: rotate(-7deg) translateX(-20px) scale(0.88);
  opacity: 0.5;
  filter: brightness(0.7);
}

/* Disappear / Morph Animation for Metrolist Old */
.card-disappear {
  z-index: 15;
  transform: translateY(-80px) rotate(-15deg) scale(0.75);
  opacity: 0;
  filter: blur(8px);
  pointer-events: none;
}

.morph-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 1.2rem;
  padding: 0.5rem 1rem;
  border-radius: var(--radius-full);
  background: rgba(16, 24, 39, 0.7);
  border: 1px solid var(--border-color);
  backdrop-filter: blur(10px);
  font-size: 0.85rem;
}

.swap-action-hint {
  color: var(--text-muted);
  font-size: 0.78rem;
}

.stacked-screens-wrapper:hover .swap-action-hint {
  color: var(--accent-cyan);
}

@media (max-width: 992px) {
  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: 3.2rem;
  }

  .hero-actions {
    justify-content: center;
  }

  .hero-showcase {
    margin-top: 2rem;
  }
}
</style>
