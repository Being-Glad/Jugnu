---
const features = [
  {
    icon: 'speed',
    title: 'Low Latency & Swift Playback',
    desc: 'Optimized InnerTube stream handling for lightning-fast song startup, zero buffering delay, and ultra-swift track switching.'
  },
  {
    icon: 'ai',
    title: 'Open-Source AI Recommendation Engine',
    desc: 'Integrated smart recommendation engine for personalized song discovery and dynamic queue generation based on your listening habits.'
  },
  {
    icon: 'lyrics',
    title: 'Live Synced Lyrics & AI Translation',
    desc: 'Sing along with Apple-style synchronized lyrics. Translate foreign lyrics in real-time with pronunciation transliteration (Hindi, Furigana, Pinyin, Hangul).'
  },
  {
    icon: 'equalizer',
    title: '10-Band Parametric Equalizer',
    desc: 'Fine-tune your sound with a 10-band parametric EQ, headphone calibration profiles (4,000+ presets), loudness normalization, and crossfade.'
  },
  {
    icon: 'theme',
    title: 'Material 3 Themes & Pure OLED Black',
    desc: 'Tailor your app with Light, Dark, Pure Pitch Black, wallpaper accent colors, and 19 custom color schemes.'
  },
  {
    icon: 'social',
    title: 'Listen Together Rooms',
    desc: 'Host virtual rooms with friends. Synchronize playback, track switching, and queue changes live in real time.'
  }
];
---

<section class="features-section" id="features">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Key Features</span>
      <h2 class="section-title">Built For Performance & Discovery</h2>
      <p class="section-description">
        Enhanced with ultra-fast song playback, built-in AI music recommendation, synchronized lyrics, and parametric EQ tuning.
      </p>
    </div>

    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">
            {f.icon === 'speed' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            )}
            {f.icon === 'ai' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
            )}
            {f.icon === 'lyrics' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            )}
            {f.icon === 'equalizer' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            )}
            {f.icon === 'theme' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
            )}
            {f.icon === 'social' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            )}
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.features-section {
  padding: 5rem 0;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

.feature-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 2.2rem;
  backdrop-filter: blur(12px);
  transition: var(--transition-normal);
}

.feature-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-highlight);
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.feature-icon {
  width: 50px;
  height: 50px;
  border-radius: var(--radius-md);
  background: rgba(212, 240, 70, 0.08);
  border: 1px solid rgba(212, 240, 70, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-lime);
  margin-bottom: 1.2rem;
}

.feature-title {
  font-size: 1.3rem;
  margin-bottom: 0.75rem;
}

.feature-desc {
  color: var(--text-secondary);
  font-size: 0.96rem;
  line-height: 1.6;
}
</style>
