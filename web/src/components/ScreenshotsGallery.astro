---
const screenshots = [
  { id: 'home', title: 'Home Feed', path: '/screenshots/home.jpg', desc: 'Trending music, featured playlists & miniplayer bar' },
  { id: 'player', title: 'Now Playing', path: '/screenshots/player.jpg', desc: 'Album artwork view with live synchronized lyrics preview' },
  { id: 'lyrics', title: 'Synced Lyrics', path: '/screenshots/lyrics.jpg', desc: 'Full-screen synchronized lyrics with Hindi & Romanized pronunciation' },
  { id: 'library', title: 'Library & Stats', path: '/screenshots/library.jpg', desc: 'Liked songs, offline downloads, cached tracks, My Top 50 & listening stats' },
  { id: 'settings', title: 'Settings & EQ', path: '/screenshots/settings.jpg', desc: '10-band parametric equalizer, AI lyrics translation & customization' },
  { id: 'search', title: 'Moods & Genres', path: '/screenshots/search.jpg', desc: 'Instant search & genre filters (Chill, Focus, Gaming, Workout, etc.)' }
];
---

<section class="showcase-section" id="preview">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Interactive Preview</span>
      <h2 class="section-title">Clean & Intuitive Interface</h2>
      <p class="section-description">
        Tap the capsules or scroll left/right to center and inspect any screen.
      </p>
    </div>

    <!-- Interactive Capsule Tabs at the Top -->
    <div class="showcase-tabs">
      {screenshots.map((s, idx) => (
        <button class={`tab-btn ${idx === 0 ? 'active' : ''}`} data-index={idx}>
          {s.title}
        </button>
      ))}
    </div>

    <!-- Borderless Clean Horizontal Carousel -->
    <div class="carousel-container">
      <button class="carousel-nav carousel-prev" id="carousel-prev" aria-label="Scroll Left">‹</button>

      <div class="showcase-carousel" id="showcase-carousel">
        {screenshots.map((s, index) => (
          <div class={`grid-card ${index === 0 ? 'active-card' : ''}`} data-index={index} id={`card-${index}`}>
            <div class="grid-card-screen">
              <img src={s.path} alt={s.title} loading="lazy" />
            </div>
            <div class="grid-card-info">
              <h4 class="grid-card-title">{s.title}</h4>
              <p class="grid-card-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <button class="carousel-nav carousel-next" id="carousel-next" aria-label="Scroll Right">›</button>
    </div>
  </div>
</section>

<!-- Fullscreen Lightbox Modal -->
<div class="lightbox-modal" id="lightbox">
  <button class="lightbox-close" id="lightbox-close" aria-label="Close Lightbox">✕</button>
  <button class="lightbox-nav-btn lightbox-modal-prev" id="lightbox-modal-prev" aria-label="Previous Image">‹</button>
  
  <div class="lightbox-content">
    <img src="" id="lightbox-img" alt="Fullscreen Screenshot" />
    <div class="lightbox-caption">
      <h3 id="lightbox-title"></h3>
      <p id="lightbox-desc"></p>
    </div>
  </div>

  <button class="lightbox-nav-btn lightbox-modal-next" id="lightbox-modal-next" aria-label="Next Image">›</button>
</div>

<script>
  const screenshots = [
    { title: 'Home Feed', path: '/screenshots/home.jpg', desc: 'Trending music, featured playlists & miniplayer bar' },
    { title: 'Now Playing', path: '/screenshots/player.jpg', desc: 'Album artwork view with live synchronized lyrics preview' },
    { title: 'Synced Lyrics', path: '/screenshots/lyrics.jpg', desc: 'Full-screen synchronized lyrics with Hindi & Romanized pronunciation' },
    { title: 'Library & Stats', path: '/screenshots/library.jpg', desc: 'Liked songs, offline downloads, cached tracks, My Top 50 & listening stats' },
    { title: 'Settings & EQ', path: '/screenshots/settings.jpg', desc: '10-band parametric equalizer, AI lyrics translation & customization' },
    { title: 'Moods & Genres', path: '/screenshots/search.jpg', desc: 'Instant search & genre filters (Chill, Focus, Gaming, Workout, etc.)' }
  ];

  const carousel = document.getElementById('showcase-carousel');
  const tabBtns = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.grid-card');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');

  let activeIndex = 0;

  function setActiveCard(index: number) {
    if (index < 0 || index >= screenshots.length) return;
    activeIndex = index;

    tabBtns.forEach((btn, i) => {
      if (i === activeIndex) {
        btn.classList.add('active');
        btn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
      } else {
        btn.classList.remove('active');
      }
    });

    cards.forEach((card, i) => {
      if (i === activeIndex) {
        card.classList.add('active-card');
      } else {
        card.classList.remove('active-card');
      }
    });

    const targetCard = document.getElementById(`card-${activeIndex}`);
    if (targetCard && carousel) {
      targetCard.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }
  }

  tabBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => setActiveCard(idx));
  });

  prevBtn?.addEventListener('click', () => {
    setActiveCard((activeIndex - 1 + screenshots.length) % screenshots.length);
  });

  nextBtn?.addEventListener('click', () => {
    setActiveCard((activeIndex + 1) % screenshots.length);
  });

  if (carousel) {
    let isScrolling: any;
    carousel.addEventListener('scroll', () => {
      clearTimeout(isScrolling);
      isScrolling = setTimeout(() => {
        const carouselCenter = carousel.getBoundingClientRect().left + carousel.offsetWidth / 2;
        let closestIndex = 0;
        let minDiff = Infinity;

        cards.forEach((card, i) => {
          const rect = card.getBoundingClientRect();
          const cardCenter = rect.left + rect.width / 2;
          const diff = Math.abs(carouselCenter - cardCenter);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = i;
          }
        });

        if (closestIndex !== activeIndex) {
          activeIndex = closestIndex;
          tabBtns.forEach((btn, i) => {
            if (i === activeIndex) btn.classList.add('active');
            else btn.classList.remove('active');
          });
          cards.forEach((card, i) => {
            if (i === activeIndex) card.classList.add('active-card');
            else card.classList.remove('active-card');
          });
        }
      }, 100);
    });
  }

  /* Fullscreen Lightbox */
  let lightboxIndex = 0;
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const closeBtn = document.getElementById('lightbox-close');
  const modalPrevBtn = document.getElementById('lightbox-modal-prev');
  const modalNextBtn = document.getElementById('lightbox-modal-next');

  function openLightbox(index: number) {
    if (!lightbox || !lightboxImg || !lightboxTitle || !lightboxDesc) return;
    lightboxIndex = index;
    const s = screenshots[lightboxIndex];
    lightboxImg.src = s.path;
    lightboxTitle.textContent = s.title;
    lightboxDesc.textContent = s.desc;
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }

  function navigateLightbox(dir: number) {
    lightboxIndex = (lightboxIndex + dir + screenshots.length) % screenshots.length;
    openLightbox(lightboxIndex);
  }

  cards.forEach((card, idx) => {
    card.addEventListener('click', () => {
      if (idx === activeIndex) {
        openLightbox(idx);
      } else {
        setActiveCard(idx);
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  modalPrevBtn?.addEventListener('click', () => navigateLightbox(-1));
  modalNextBtn?.addEventListener('click', () => navigateLightbox(1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigateLightbox(-1);
    if (e.key === 'ArrowRight') navigateLightbox(1);
  });
</script>

<style>
.showcase-section {
  padding: 5rem 0;
  position: relative;
}

/* Capsule Tabs Bar at the Top */
.showcase-tabs {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 2.5rem;
}

.tab-btn {
  padding: 0.65rem 1.5rem;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: var(--transition-fast);
}

.tab-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

.tab-btn.active {
  background: var(--gradient-brand);
  color: #041019;
  font-weight: 700;
  border-color: transparent;
  box-shadow: 0 4px 20px rgba(6, 182, 212, 0.4);
}

/* Horizontal Track */
.carousel-container {
  position: relative;
  display: flex;
  align-items: center;
}

.showcase-carousel {
  display: flex;
  gap: 2rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  padding: 2rem 1.5rem 2.5rem;
  width: 100%;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.showcase-carousel::-webkit-scrollbar {
  display: none;
}

/* Completely Borderless Card with Pure Smooth Scale Zoom (No Blur, No Dark Overlay) */
.grid-card {
  flex: 0 0 250px;
  scroll-snap-align: center;
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  cursor: pointer;
  opacity: 0.75;
  transform: scale(0.95);
  transition: transform 0.4s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.4s ease, filter 0.4s ease;
  filter: brightness(0.9);
}

.grid-card:hover, .grid-card.active-card {
  opacity: 1;
  transform: scale(1.08) translateY(-8px);
  filter: brightness(1);
}

.grid-card-screen {
  position: relative;
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  background: transparent;
  border: none;
  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.85);
}

.grid-card-screen img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12px;
  object-fit: contain;
}

.grid-card-info {
  margin-top: 1rem;
  padding: 0 0.2rem;
  text-align: center;
}

.grid-card-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.2rem;
}

.grid-card-desc {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.4;
}

/* Carousel Side Nav Buttons */
.carousel-nav {
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  z-index: 10;
  width: 46px;
  height: 46px;
  border-radius: var(--radius-full);
  background: rgba(16, 24, 39, 0.85);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  font-size: 1.8rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
  backdrop-filter: blur(10px);
}

.carousel-nav:hover {
  background: var(--accent-cyan);
  color: #041019;
  box-shadow: 0 0 20px rgba(6, 182, 212, 0.5);
}

.carousel-prev { left: -15px; }
.carousel-next { right: -15px; }

/* Lightbox Modal */
.lightbox-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(4, 6, 10, 0.92);
  backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.lightbox-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.lightbox-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 90vw;
  max-height: 90vh;
}

.lightbox-content img {
  max-height: 75vh;
  width: auto;
  border-radius: 12px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
}

.lightbox-caption {
  margin-top: 1.2rem;
  text-align: center;
}

.lightbox-caption h3 {
  font-size: 1.4rem;
  color: var(--text-primary);
}

.lightbox-caption p {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.lightbox-close {
  position: absolute;
  top: 2rem;
  right: 2rem;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  width: 44px;
  height: 44px;
  border-radius: var(--radius-full);
  font-size: 1.4rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.lightbox-close:hover {
  background: rgba(255, 255, 255, 0.2);
}

.lightbox-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  width: 50px;
  height: 50px;
  border-radius: var(--radius-full);
  font-size: 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.lightbox-nav-btn:hover {
  background: var(--accent-cyan);
  color: #041019;
}

.lightbox-modal-prev { left: 2rem; }
.lightbox-modal-next { right: 2rem; }

@media (max-width: 768px) {
  .carousel-prev { left: 0; }
  .carousel-next { right: 0; }
  .lightbox-modal-prev { left: 0.5rem; }
  .lightbox-modal-next { right: 0.5rem; }
}
</style>
