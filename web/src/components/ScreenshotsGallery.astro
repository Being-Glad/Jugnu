---
const screenshots = [
  { id: 'library', title: 'Library & Stats', path: '/screenshots/library.jpg', desc: 'Liked songs, offline downloads, cached tracks, My Top 50 & listening stats' },
  { id: 'settings', title: 'Settings & EQ', path: '/screenshots/settings.jpg', desc: '10-band parametric equalizer, AI lyrics translation & customization' },
  { id: 'lyrics', title: 'Synced Lyrics', path: '/screenshots/lyrics.jpg', desc: 'Full-screen synchronized lyrics with Hindi & Romanized pronunciation' },
  { id: 'home', title: 'Home Feed', path: '/screenshots/jugnu_home.jpg', desc: 'Trending music, featured playlists & miniplayer bar' },
  { id: 'player', title: 'Now Playing', path: '/screenshots/player.jpg', desc: 'Album artwork view with live synchronized lyrics preview' },
  { id: 'search', title: 'Moods & Genres', path: '/screenshots/search.jpg', desc: 'Instant search & genre filters (Chill, Focus, Gaming, Workout, etc.)' },
  { id: 'account', title: 'Account & Social', path: '/screenshots/account.jpg', desc: 'Login with Google, listen Together with friends in real time' }
];
---

<section class="hero-preview" id="preview">

  <!-- Hero CTA at the top -->
  <div class="hero-top">


    <h1 class="hero-title">
      Metrolist, evolved into <span class="gradient-text">Jugnu.</span>
    </h1>

    <p class="hero-subtitle">
      A lightning-fast YouTube Music client — with live synced lyrics, AI translation, and built-in music recommendation.
    </p>

    <div class="hero-actions">
      <a href="https://github.com/Being-Glad/Jugnu/releases/latest/download/Jugnu.apk" class="btn btn-primary btn-lg" id="hero-download-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Download Jugnu APK</span>
      </a>
      <a href="https://github.com/Being-Glad/Jugnu" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="hero-github-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>
    </div>

    <div class="hero-meta">
      <div class="hero-meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Free &amp; Open Source</span>
      </div>
      <div class="hero-meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
        <span>No Ads</span>
      </div>
      <div class="hero-meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Low Latency</span>
      </div>
    </div>
  </div>

  <!-- Capsule Tab Bar -->
  <div class="showcase-tabs">
    {screenshots.map((s, idx) => (
      <button class={`tab-btn ${idx === 3 ? 'active' : ''}`} data-index={idx} id={`tab-${idx}`}>
        {s.title}
      </button>
    ))}
  </div>

  <!-- Phone Carousel -->
  <div class="carousel-wrapper">
    <button class="carousel-nav carousel-prev" id="carousel-prev" aria-label="Scroll Left">‹</button>

    <div class="showcase-carousel" id="showcase-carousel">
      {screenshots.map((s, index) => (
        <div class={`grid-card ${index === 3 ? 'active-card' : ''}`} data-index={index} id={`card-${index}`}>
          <div class="grid-card-screen">
            <img src={s.path} alt={s.title} loading={index >= 2 && index <= 4 ? 'eager' : 'lazy'} />
          </div>
        </div>
      ))}
    </div>

    <button class="carousel-nav carousel-next" id="carousel-next" aria-label="Scroll Right">›</button>
  </div>

  <!-- Active Card Info -->
  <div class="active-card-info">
    <h4 class="active-card-title" id="active-title">Home Feed</h4>
    <p class="active-card-desc" id="active-desc">Trending music, featured playlists &amp; miniplayer bar</p>
  </div>

</section>

<!-- Fullscreen Lightbox Modal -->
<div class="lightbox-modal" id="lightbox">
  <button class="lightbox-close" id="lightbox-close" aria-label="Close Lightbox">✕</button>
  <button class="lightbox-nav-btn lightbox-modal-prev" id="lightbox-modal-prev" aria-label="Previous Image">‹</button>
  <div class="lightbox-content">
    <img src="" id="lightbox-img" alt="Fullscreen Screenshot" />
    <div class="lightbox-caption">
      <h3 id="lightbox-title"></h3>
      <p id="lightbox-desc"></p>
    </div>
  </div>
  <button class="lightbox-nav-btn lightbox-modal-next" id="lightbox-modal-next" aria-label="Next Image">›</button>
</div>

<script>
  const screenshots = [
    { title: 'Library & Stats', path: '/screenshots/library.jpg', desc: 'Liked songs, offline downloads, cached tracks, My Top 50 & listening stats' },
    { title: 'Settings & EQ', path: '/screenshots/settings.jpg', desc: '10-band parametric equalizer, AI lyrics translation & customization' },
    { title: 'Synced Lyrics', path: '/screenshots/lyrics.jpg', desc: 'Full-screen synchronized lyrics with Hindi & Romanized pronunciation' },
    { title: 'Home Feed', path: '/screenshots/jugnu_home.jpg', desc: 'Trending music, featured playlists & miniplayer bar' },
    { title: 'Now Playing', path: '/screenshots/player.jpg', desc: 'Album artwork view with live synchronized lyrics preview' },
    { title: 'Moods & Genres', path: '/screenshots/search.jpg', desc: 'Instant search & genre filters (Chill, Focus, Gaming, Workout, etc.)' },
    { title: 'Account & Social', path: '/screenshots/account.jpg', desc: 'Login with Google, listen Together with friends in real time' }
  ];

  const carousel = document.getElementById('showcase-carousel');
  const tabBtns = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.grid-card');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const activeTitle = document.getElementById('active-title');
  const activeDesc = document.getElementById('active-desc');

  let activeIndex = 3; // Home Feed at center (index 3 of 7)

  function updateInfo(index: number) {
    if (activeTitle) activeTitle.textContent = screenshots[index].title;
    if (activeDesc) activeDesc.textContent = screenshots[index].desc;
  }

  function setActiveCard(index: number) {
    if (index < 0 || index >= screenshots.length) return;
    activeIndex = index;

    tabBtns.forEach((btn, i) => {
      btn.classList.toggle('active', i === activeIndex);
    });

    cards.forEach((card, i) => {
      card.classList.toggle('active-card', i === activeIndex);
    });

    const targetCard = document.getElementById(`card-${activeIndex}`);
    if (targetCard && carousel) {
      targetCard.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    updateInfo(activeIndex);
  }

  // Init: center on Home Feed (index 3)
  setTimeout(() => {
    const initCard = document.getElementById('card-3');
    if (initCard && carousel) {
      initCard.scrollIntoView({ behavior: 'instant', inline: 'center', block: 'nearest' });
    }
    updateInfo(3);
  }, 0);

  // Auto-return to Home Feed (index 3) after inactivity
  let inactivityTimeout: any;
  function startInactivityTimer() {
    clearTimeout(inactivityTimeout);
    inactivityTimeout = setTimeout(() => {
      if (activeIndex !== 3) setActiveCard(3);
    }, 2500); // 2.5s after mouse leaves
  }

  const heroSection = document.querySelector('.hero-preview');
  heroSection?.addEventListener('mouseenter', () => clearTimeout(inactivityTimeout));
  heroSection?.addEventListener('mouseleave', startInactivityTimer);
  heroSection?.addEventListener('touchstart', () => clearTimeout(inactivityTimeout), {passive: true});
  heroSection?.addEventListener('touchend', startInactivityTimer, {passive: true});
  startInactivityTimer(); // Start on load

  tabBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => setActiveCard(idx));
  });

  prevBtn?.addEventListener('click', () => {
    setActiveCard((activeIndex - 1 + screenshots.length) % screenshots.length);
  });

  nextBtn?.addEventListener('click', () => {
    setActiveCard((activeIndex + 1) % screenshots.length);
  });

  // Scroll-snap sync
  if (carousel) {
    let isScrolling: any;
    carousel.addEventListener('scroll', () => {
      clearTimeout(isScrolling);
      isScrolling = setTimeout(() => {
        const carouselCenter = carousel.getBoundingClientRect().left + carousel.offsetWidth / 2;
        let closestIndex = 0;
        let minDiff = Infinity;
        cards.forEach((card, i) => {
          const rect = card.getBoundingClientRect();
          const cardCenter = rect.left + rect.width / 2;
          const diff = Math.abs(carouselCenter - cardCenter);
          if (diff < minDiff) { minDiff = diff; closestIndex = i; }
        });
        if (closestIndex !== activeIndex) {
          activeIndex = closestIndex;
          tabBtns.forEach((btn, i) => btn.classList.toggle('active', i === activeIndex));
          cards.forEach((card, i) => card.classList.toggle('active-card', i === activeIndex));
          updateInfo(activeIndex);
        }
      }, 80);
    });
  }

  let hoverTimeout: any;
  // Hover to select, click to open lightbox
  cards.forEach((card, idx) => {
    card.addEventListener('mouseenter', () => {
      if (idx !== activeIndex) {
        clearTimeout(hoverTimeout);
        hoverTimeout = setTimeout(() => setActiveCard(idx), 150);
      }
    });
    card.addEventListener('mouseleave', () => {
      clearTimeout(hoverTimeout);
    });
    card.addEventListener('click', () => {
      // If they click, we assume they want to view it fullscreen
      // (it will already be active due to hover, but just in case)
      setActiveCard(idx);
      openLightbox(idx);
    });
  });

  /* Lightbox */
  let lightboxIndex = 0;
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');

  function openLightbox(index: number) {
    if (!lightbox || !lightboxImg) return;
    lightboxIndex = index;
    const s = screenshots[lightboxIndex];
    lightboxImg.src = s.path;
    if (lightboxTitle) lightboxTitle.textContent = s.title;
    if (lightboxDesc) lightboxDesc.textContent = s.desc;
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  function navigateLightbox(dir: number) {
    lightboxIndex = (lightboxIndex + dir + screenshots.length) % screenshots.length;
    openLightbox(lightboxIndex);
  }

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-modal-prev')?.addEventListener('click', () => navigateLightbox(-1));
  document.getElementById('lightbox-modal-next')?.addEventListener('click', () => navigateLightbox(1));
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  window.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigateLightbox(-1);
    if (e.key === 'ArrowRight') navigateLightbox(1);
  });
</script>

<style>
/* ─── Merged Hero + Preview — full viewport on desktop ─── */
.hero-preview {
  min-height: 100svh; /* svh = small viewport height, correct on mobile */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 5rem;
  padding-bottom: 1rem;
  position: relative;
  overflow: hidden;
}

/* Subtle glow behind phones */
.hero-preview::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 500px;
  background: radial-gradient(ellipse at center bottom, rgba(6, 182, 212, 0.08) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ─── Compact Hero CTA ─── */
.hero-top {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  z-index: 2;
  position: relative;
  max-width: 680px;
  padding: 0 1.5rem;
  margin-bottom: 1rem;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.3rem 0.9rem;
  border-radius: var(--radius-full);
  background: rgba(6, 182, 212, 0.08);
  border: 1px solid var(--border-highlight);
  color: var(--accent-cyan);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  margin-bottom: 0.8rem;
}

.badge-dot {
  font-size: 0.6rem;
  color: var(--accent-teal);
}

.hero-title {
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  letter-spacing: -1.8px;
  line-height: 1.06;
  margin-bottom: 0.6rem;
  font-weight: 800;
}

.hero-subtitle {
  font-size: clamp(0.88rem, 1.2vw, 1rem);
  color: var(--text-secondary);
  margin-bottom: 1.1rem;
  max-width: 520px;
  line-height: 1.55;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: 0.9rem;
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.4rem;
  color: var(--text-muted);
  font-size: 0.82rem;
}

.hero-meta-item {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.hero-meta-item svg {
  color: var(--accent-teal);
  flex-shrink: 0;
}

/* ─── Capsule Tabs ─── */
.showcase-tabs {
  flex: 0 0 auto;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.9rem;
  z-index: 2;
  position: relative;
  padding: 0 1rem;
}

.tab-btn {
  padding: 0.45rem 1.1rem;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.8rem;
  cursor: pointer;
  transition: var(--transition-fast);
  white-space: nowrap;
}

.tab-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

.tab-btn.active {
  background: var(--gradient-brand);
  color: #041019;
  font-weight: 700;
  border-color: transparent;
  box-shadow: 0 4px 20px rgba(6, 182, 212, 0.4);
}

/* ─── Carousel ─── */
.carousel-wrapper {
  flex: 1;
  min-height: 0;
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  z-index: 2;
}

.showcase-carousel {
  display: flex;
  gap: 0; /* Let fixed widths and scale handle spacing */
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  padding: 0.5rem 6vw 1rem;
  width: 100%;
  height: 100%;
  scrollbar-width: none;
  -ms-overflow-style: none;
  align-items: flex-end;
}

.showcase-carousel::-webkit-scrollbar { display: none; }

/* ─── Phone Cards ─── */
.grid-card {
  flex: 0 0 auto;
  width: 210px; /* Locked physical layout width */
  height: 100%; /* Rigidly lock to carousel height */
  scroll-snap-align: center;
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  cursor: pointer;
  opacity: 0.5;
  transform: scale(0.84) translateY(18px);
  transform-origin: bottom center; /* Scale from bottom */
  transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1),
              opacity 0.4s ease,
              filter 0.4s ease; /* Removed width transition */
  filter: brightness(0.7) saturate(0.6);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  z-index: 1;
}

.grid-card.active-card {
  /* No width change here! No layout bounce! */
  opacity: 1;
  transform: scale(1) translateY(0);
  filter: brightness(1) saturate(1);
  z-index: 10; /* Bring above other cards */
}

.grid-card:hover:not(.active-card) {
  opacity: 0.7;
  filter: brightness(0.88) saturate(0.8);
}

/* Screen container */
.grid-card-screen {
  width: 100%;
  flex: 1;
  min-height: 0; /* allows flex child to shrink properly */
  border-radius: 20px;
  overflow: hidden;
  background: transparent;
  box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.9),
              0 0 0 1px rgba(255,255,255,0.04);
}

.grid-card.active-card .grid-card-screen {
  border-radius: 24px;
  box-shadow: 0 40px 80px -10px rgba(0, 0, 0, 0.95),
              0 0 0 1px rgba(6, 182, 212, 0.18),
              0 0 60px rgba(6, 182, 212, 0.08);
}

/* Images */
.grid-card-screen img {
  width: 100%;
  height: 100%; /* stretch to fill container, object-fit handles aspect */
  display: block;
  border-radius: inherit;
  object-fit: contain;
}

/* ─── Active Card Info (pinned bottom) ─── */
.active-card-info {
  flex: 0 0 auto;
  text-align: center;
  padding: 0.6rem 1rem 0.8rem;
  z-index: 2;
  position: relative;
  height: 60px; /* fixed height prevents bouncy text shifts */
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.active-card-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.15rem;
}

.active-card-desc {
  font-size: 0.8rem;
  color: var(--text-muted);
  max-width: 400px;
  margin: 0 auto;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* forces single line so height never wraps */
}

/* ─── Carousel Nav Buttons ─── */
.carousel-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-full);
  background: rgba(16, 24, 39, 0.85);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  font-size: 1.8rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
  backdrop-filter: blur(10px);
}

.carousel-nav:hover {
  background: var(--accent-cyan);
  color: #041019;
  box-shadow: 0 0 20px rgba(6, 182, 212, 0.5);
}

.carousel-prev { left: 8px; }
.carousel-next { right: 8px; }

/* ─── Lightbox ─── */
.lightbox-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(4, 6, 10, 0.92);
  backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.lightbox-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.lightbox-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 90vw;
  max-height: 90vh;
}

.lightbox-content img {
  max-height: 75vh;
  width: auto;
  border-radius: 16px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
}

.lightbox-caption {
  margin-top: 1.2rem;
  text-align: center;
}

.lightbox-caption h3 {
  font-size: 1.3rem;
  color: var(--text-primary);
  margin-bottom: 0.3rem;
}

.lightbox-caption p {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.lightbox-close {
  position: absolute;
  top: 2rem;
  right: 2rem;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  width: 44px;
  height: 44px;
  border-radius: var(--radius-full);
  font-size: 1.3rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.lightbox-close:hover { background: rgba(255,255,255,0.2); }

.lightbox-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  width: 50px;
  height: 50px;
  border-radius: var(--radius-full);
  font-size: 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.lightbox-nav-btn:hover { background: var(--accent-cyan); color: #041019; }
.lightbox-modal-prev { left: 2rem; }
.lightbox-modal-next { right: 2rem; }

/* ─── Responsive ─── */
@media (max-width: 768px) {
  /* On mobile: don't enforce 100vh — let content flow naturally */
  .hero-preview {
    height: auto;
    min-height: 100svh;
    padding-top: 4.5rem;
    padding-bottom: 2rem;
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* Compact text even further on mobile */
  .hero-top { margin-bottom: 0.8rem; }
  .hero-title { font-size: 2.2rem; letter-spacing: -1px; }
  .hero-subtitle { font-size: 0.85rem; margin-bottom: 0.8rem; }
  .hero-actions { gap: 0.6rem; margin-bottom: 0.6rem; }
  .hero-meta { flex-wrap: wrap; gap: 0.8rem; justify-content: center; }

  /* Tabs: tighter on mobile */
  .showcase-tabs { gap: 0.4rem; margin-bottom: 0.7rem; }
  .tab-btn { padding: 0.4rem 0.85rem; font-size: 0.75rem; }

  /* Carousel: natural height, no flex:1 stretch */
  .carousel-wrapper {
    flex: 0 0 auto;
  }

  .showcase-carousel {
    height: auto;
    padding: 0.5rem 1.5rem 1rem;
