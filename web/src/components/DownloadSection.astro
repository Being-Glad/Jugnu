---
---

<section class="download-section" id="download">
  <div class="container">
    <div class="download-card">
      <h2 class="download-card-title">Get Jugnu Today</h2>
      <p class="download-card-subtitle">
        Download the latest release APK directly from the official GitHub repository.
      </p>

      <div class="download-primary-action">
        <a href="https://github.com/Being-Glad/Jugnu/releases/latest/download/Jugnu.apk" class="btn btn-primary btn-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Download Release APK</span>
        </a>
      </div>

      <div class="install-steps">
        <div class="step-box">
          <span class="step-number">1</span>
          <div class="step-text">Download the <strong>Jugnu.apk</strong> file from GitHub releases.</div>
        </div>
        <div class="step-box">
          <span class="step-number">2</span>
          <div class="step-text">Allow installation from "Unknown Sources" if prompted by Android.</div>
        </div>
        <div class="step-box">
          <span class="step-number">3</span>
          <div class="step-text">Tap <strong>Install</strong> and launch Jugnu to enjoy ad-free music!</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.download-section {
  padding: 5rem 0;
}

.download-card {
  background: linear-gradient(135deg, rgba(16, 24, 39, 0.8) 0%, rgba(8, 12, 20, 0.95) 100%);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-lg);
  padding: 3.5rem 2rem;
  text-align: center;
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

.download-card-title {
  font-size: 2.8rem;
  margin-bottom: 0.8rem;
}

.download-card-subtitle {
  color: var(--text-secondary);
  font-size: 1.15rem;
  max-width: 600px;
  margin: 0 auto 2.2rem;
}

.download-primary-action {
  display: flex;
  justify-content: center;
  margin-bottom: 2.5rem;
}

.install-steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  max-width: 900px;
  margin: 0 auto;
  text-align: left;
}

.step-box {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.4rem;
}

.step-number {
  display: inline-block;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: var(--accent-cyan);
  color: #041019;
  font-weight: 800;
  font-size: 0.85rem;
  text-align: center;
  line-height: 28px;
  margin-bottom: 0.8rem;
}

.step-text {
  font-size: 0.95rem;
  color: var(--text-secondary);
}
</style>
