---
---

<section class="download-section" id="download">
  <div class="container">
    <div class="download-card">
      <h2 class="download-card-title">Get Jugnu Today</h2>
      <p class="download-card-subtitle">
        Download the latest release APK directly from GitHub or your favorite open-source repository.
      </p>

      <div class="download-primary-action">
        <a href="https://github.com/MetrolistGroup/Metrolist/releases/latest/download/Metrolist.apk" class="btn btn-primary btn-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Download Jugnu APK</span>
        </a>
      </div>

      <div class="download-badges">
        <a href="https://apps.obtainium.imranr.dev/redirect?r=obtainium://add/https://github.com/MetrolistGroup/Metrolist/" class="badge-item" title="Download via Obtainium">
          <img src="https://github.com/ImranR98/Obtainium/raw/main/assets/graphics/badge_obtainium.png" alt="Obtainium Badge" />
        </a>
        <a href="https://apt.izzysoft.de/fdroid/index/apk/com.metrolist.music" class="badge-item" title="Download on IzzyOnDroid">
          <img src="https://gitlab.com/IzzyOnDroid/repo/-/raw/master/assets/IzzyOnDroid.png" alt="IzzyOnDroid Badge" />
        </a>
        <a href="https://www.openapk.net/metrolist/com.metrolist.music/" class="badge-item" title="Download on OpenAPK">
          <img src="https://www.openapk.net/images/openapk-badge.png" alt="OpenAPK Badge" />
        </a>
      </div>

      <div class="install-steps">
        <div class="step-box">
          <span class="step-number">1</span>
          <div class="step-text">Download <strong>Jugnu.apk</strong> file from GitHub releases.</div>
        </div>
        <div class="step-box">
          <span class="step-number">2</span>
          <div class="step-text">Allow installation from "Unknown Sources" if prompted by Android.</div>
        </div>
        <div class="step-box">
          <span class="step-number">3</span>
          <div class="step-text">Tap <strong>Install</strong> and start enjoying ad-free music!</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.download-section {
  padding: 5rem 0;
}

.download-card {
  background: linear-gradient(135deg, rgba(16, 24, 39, 0.8) 0%, rgba(8, 12, 20, 0.95) 100%);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-lg);
  padding: 3.5rem 2rem;
  text-align: center;
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

.download-card-title {
  font-size: 2.8rem;
  margin-bottom: 0.8rem;
}

.download-card-subtitle {
  color: var(--text-secondary);
  font-size: 1.15rem;
  max-width: 600px;
  margin: 0 auto 2.2rem;
}

.download-primary-action {
  display: flex;
  justify-content: center;
  margin-bottom: 2.5rem;
}

.download-badges {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 3rem;
}

.badge-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem 1.4rem;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-color);
  transition: var(--transition-fast);
  height: 54px;
}

.badge-item:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.25);
  transform: translateY(-3px);
}

.badge-item img {
  height: 32px;
  width: auto;
}

.install-steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  max-width: 900px;
  margin: 0 auto;
  text-align: left;
}

.step-box {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.4rem;
}

.step-number {
  display: inline-block;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: var(--accent-cyan);
  color: #041019;
  font-weight: 800;
  font-size: 0.85rem;
  text-align: center;
  line-height: 28px;
  margin-bottom: 0.8rem;
}

.step-text {
  font-size: 0.95rem;
  color: var(--text-secondary);
}
</style>
